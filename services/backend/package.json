{
  "name": "minimum-fee-job",
  "private": "true",
  "version": "1.3.2",
  "description": "A process to check minimum fee config with current price of tokens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/minimum-fee-job.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test:avalanche": "node --import tsx ../../scripts/test-avalanche.mjs --service backend",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . --max-warnings=0 && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "start": "tsx ./src/index.ts",
    "start:dev": "tsx watch ./src/index.ts",
    "threshold": "tsx ./src/threshold.ts",
    "type-check": "tsc --noEmit",
    "postinstall": "patch-package",
    "typeorm:generate:sqlite": "npm run typeorm migration:generate src/database/migrations/sqlite/migration  -- -p -d src/database/dataSource.ts",
    "typeorm:generate:postgres": "npm run typeorm migration:generate src/database/migrations/postgres/migration  -- -p -d src/database/dataSource.ts",
    "typeorm:migrate": "npm run typeorm migration:run -- -d src/database/dataSource.ts",
    "typeorm": "NODE_OPTIONS='--import tsx' typeorm"
  },
  "dependencies": {
    "@rosen-bridge/abstract-logger": "^4.0.0",
    "@rosen-bridge/ergo-box-selection": "^2.1.1",
    "@rosen-bridge/extended-typeorm": "^1.1.0",
    "@rosen-bridge/firo-scanner": "^0.2.2",
    "@rosen-bridge/json-bigint": "^1.1.0",
    "@rosen-bridge/minimum-fee": "^3.1.2",
    "@rosen-bridge/token-price-entity": "^0.2.2",
    "@rosen-bridge/tokens": "^5.0.0",
    "@rosen-clients/cardano-koios": "3.1.3",
    "@rosen-clients/ergo-explorer": "2.1.3",
    "@rosen-bridge/winston-logger": "^3.1.0",
    "@vercel/kv": "^3.0.0",
    "axios": "^1.6.2",
    "config": "^3.3.7",
    "discord.js": "^14.14.1",
    "ergo-lib-wasm-nodejs": "^0.24.1",
    "ethers": "^6.13.2",
    "lodash-es": "^4.17.21",
    "patch-package": "^8.0.0",
    "pg": "^8.16.3",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/config": "^0.0.41",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.18.0",
    "typeorm": "^0.3.27",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
