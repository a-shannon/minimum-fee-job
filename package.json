{
  "name": "minimum-fee-job",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "services/*"
    ]
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:avalanche": "node --import tsx scripts/test-avalanche.mjs",
    "prepare:avalanche-fixtures": "node scripts/prepare-avalanche-fixtures.mjs",
    "coverage": "npm run coverage --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:check": "npm run lint:check --workspaces",
    "prepare": "husky install",
    "release": "npm run release --workspaces",
    "type-check": "npm run type-check --workspaces",
    "madge": "madge --circular --extensions ts ./",
    "clean": "npm run clean --workspaces",
    "version": "npx changeset version && npx changeset add --empty && npm i"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "^15.5.3",
    "@rosen-bridge/changeset-formatter": "^2.0.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.18.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitest/eslint-plugin": "^1.3.9",
    "@vitest/coverage-istanbul": "^3.1.4",
    "vitest": "^3.1.4",
    "tsx": "^4.19.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-check-file": "^3.2.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^8.0.0",
    "knip": "^5.65.0",
    "lint-staged": "^13.0.3",
    "madge": "^8.0.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
